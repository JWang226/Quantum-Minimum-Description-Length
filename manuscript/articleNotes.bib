@FOOTNOTE{Note1,key="Note1",note="The definition can also be adapted to certain non-self-adjoint operators, such as unitaries."}
@FOOTNOTE{Note2,key="Note2",note="For multivariate free entropy one must use closeness of moments, as no multivariate spectral density exists."}
@FOOTNOTE{Note3,key="Note3",note="This is because the spectral density of $x$ can be continuous and we cannot compare a continuous density against a discrete one using the $L_2$-norm distance."}
@FOOTNOTE{Note4,key="Note4",note="A Gaussian reference measure instead produces a related free-energy functional containing an additional quadratic-moment term, so we keep the Lebesgue convention here."}
@FOOTNOTE{Note5,key="Note5",note="At fixed $d$, its logarithm agrees with the logarithm of the covering number up to $O(1)$ as $\varepsilon \to 0$~\cite {Kolmogorov1963,KolmogorovTikhomirov1961}. We use the volume ratio to fix that ambiguity."}
@FOOTNOTE{Note6,key="Note6",note="We use log dimension; rounding up to a whole number of qubits can change the additive constant."}
@FOOTNOTE{Note7,key="Note7",note="The version where the state is unknown is called ``universal quantum data compression''~\cite {jozsa1998universal,hayashi2002quantum,hayashi2002simple,hayashi2010universal}."}
@FOOTNOTE{Note8,key="Note8",note="Standard microstate free entropy does not directly apply to type~III algebras, where no trace exists; any non-tracial extension requires separate treatment."}
